import re
import tkinter as tk
from tkinter import filedialog, messagebox


class RegexGUI:
	def __init__(self, root):
		self.root = root
		root.title("Regex Text Processor")
		root.geometry("1000x700")

		tk.Label(root, text="ข้อความต้นฉบับ").pack(anchor="w", padx=8, pady=(8, 0))
		self.source = tk.Text(root, height=12, wrap="word")
		self.source.pack(fill="both", expand=True, padx=8)

		controls = tk.Frame(root)
		controls.pack(fill="x", padx=8, pady=6)
		tk.Button(controls, text="Load", command=self.load_file).pack(side="left")
		tk.Button(controls, text="Clear", command=lambda: self.source.delete("1.0", "end")).pack(side="left", padx=4)
		tk.Label(controls, text="พารามิเตอร์:").pack(side="left", padx=(15, 4))
		self.param = tk.Entry(controls, width=28)
		self.param.insert(0, r"\\w+")
		self.param.pack(side="left")

		buttons = tk.Frame(root)
		buttons.pack(fill="x", padx=8, pady=4)
		actions = [
			("1 ค้นหา", self.find), ("2 แทนที่", self.replace),
			("3 ตัวเลข", self.numbers), ("4 อีเมล", self.emails),
			("5 URL", self.urls), ("6 คำไทย", self.thai),
			("7 คำซ้ำ", self.duplicates), ("8 แยกบรรทัด", self.lines),
			("9 ลบช่องว่าง", self.remove_spaces), ("10 สถิติ", self.stats),
		]
		for text, command in actions:
			tk.Button(buttons, text=text, command=command).pack(side="left", padx=2, pady=2)

		tk.Label(root, text="ผลลัพธ์").pack(anchor="w", padx=8, pady=(6, 0))
		self.result = tk.Text(root, height=14, wrap="word", bg="#f4f4f4")
		self.result.pack(fill="both", expand=True, padx=8, pady=(0, 8))

	def text(self):
		return self.source.get("1.0", "end-1c")

	def pattern(self):
		value = self.param.get().strip()
		if not value:
			raise ValueError("กรุณาใส่ regular expression")
		return re.compile(value, re.MULTILINE)

	def show(self, value):
		self.result.delete("1.0", "end")
		self.result.insert("1.0", str(value))

	def run(self, operation):
		try:
			self.show(operation())
		except (re.error, ValueError) as error:
			messagebox.showerror("Regex error", str(error))
		except Exception as error:
			messagebox.showerror("Error", str(error))

	def find(self):
		self.run(lambda: "\n".join(m.group(0) for m in self.pattern().finditer(self.text())) or "ไม่พบข้อมูล")

	def replace(self):
		replacement = self.param.get()
		self.run(lambda: self.pattern().sub(replacement, self.text()))

	def numbers(self):
		self.run(lambda: "\n".join(re.findall(self.param.get() or r"\d+", self.text())) or "ไม่พบตัวเลข")

	def emails(self):
		self.run(lambda: "\n".join(re.findall(self.param.get() or r"[\w.+-]+@[\w-]+\.[\w.-]+", self.text())) or "ไม่พบอีเมล")

	def urls(self):
		self.run(lambda: "\n".join(re.findall(self.param.get() or r"https?://[^\s]+", self.text())) or "ไม่พบ URL")

	def thai(self):
		self.run(lambda: "\n".join(re.findall(self.param.get() or r"[ก-๙]+", self.text())) or "ไม่พบคำไทย")

	def duplicates(self):
		def operation():
			words = re.findall(self.param.get() or r"\w+", self.text(), re.IGNORECASE)
			seen, duplicates = set(), []
			for word in words:
				key = word.lower()
				if key in seen and key not in duplicates:
					duplicates.append(key)
				seen.add(key)
			return "\n".join(duplicates) or "ไม่พบคำซ้ำ"
		self.run(operation)

	def lines(self):
		self.run(lambda: "\n".join(x for x in self.text().splitlines() if re.search(self.param.get() or r".", x)) or "ไม่พบบรรทัด")

	def remove_spaces(self):
		self.run(lambda: re.sub(self.param.get() or r"\s+", " ", self.text()).strip())

	def stats(self):
		def operation():
			text = self.text()
			matches = self.pattern().findall(text)
			return f"จำนวนอักขระ: {len(text)}\nจำนวนบรรทัด: {len(text.splitlines())}\nจำนวนที่ตรง pattern: {len(matches)}"
		self.run(operation)

	def load_file(self):
		try:
			filename = filedialog.askopenfilename(filetypes=[("Text files", "*.txt"), ("All files", "*.*")])
			if filename:
				with open(filename, "r", encoding="utf-8") as file:
					self.source.delete("1.0", "end")
					self.source.insert("1.0", file.read())
		except (OSError, UnicodeError) as error:
			messagebox.showerror("Load error", str(error))


if __name__ == "__main__":
	root = tk.Tk()
	RegexGUI(root)
	root.mainloop()
